# ---------------------------------------------------------------------------
# fractionl-pulse environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# ===========================================================================
# Client (Vite) — exposed to the browser bundle, must be prefixed with VITE_
# ===========================================================================

# Supabase project URL (e.g. https://xxxxxxxx.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co
# Supabase anon/public JWT — safe for the client, RLS-protected
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ===========================================================================
# Server — Vercel API routes (api/) — server-only, never exposed to client
# ===========================================================================

# Supabase project URL used by api/ routes (REST + edge function calls)
SUPABASE_URL=https://your-project.supabase.co
# Supabase service-role key — full DB access, server-side only
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Shared secret used to authenticate Vercel Cron invocations
CRON_SECRET=your-cron-secret

# ===========================================================================
# Scripts — scripts/historical-backfill.ts (run locally / CI)
# ===========================================================================

# Supabase service key used by the backfill script (alias of service-role key)
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ===========================================================================
# Supabase Edge Function secrets (set via `supabase secrets set`)
# Referenced by supabase/functions/* via Deno.env.get(). Listed here for
# reference — these are NOT loaded from this file at runtime.
# ===========================================================================

# OpenAI API key — generate-pulse-insights
OPENAI_API_KEY=your-openai-api-key
# Brave Search API key — generate-pulse-insights, ingest-signals
BRAVE_API_KEY=your-brave-api-key
# Resend API key — send-pipeline-alert (email alerts)
RESEND_API_KEY=your-resend-api-key
# Apify API token — ingest-signals, backfill-historical
APIFY_API_KEY=your-apify-api-key
# NewsAPI key — ingest-signals, backfill-historical
NEWS_API_KEY=your-news-api-key
# Adzuna app ID — ingest-signals
ADZUNA_APP_ID=your-adzuna-app-id
# Adzuna app key — ingest-signals
ADZUNA_APP_KEY=your-adzuna-app-key
# Retired 2026-05-30; retained only for historical/rollback tooling.
PDL_API_KEY=your-pdl-api-key
# FRED (Federal Reserve) API key — ingest-signals, scripts/historical-backfill.ts
FRED_API_KEY=your-fred-api-key
# Raw DataForSEO API login + generated API password — ingest, jobs preparation, and Content Radar.
# The functions build the Basic Auth value at runtime; do not paste or store a Base64 credential here.
DATAFORSEO_LOGIN=your-dataforseo-login
DATAFORSEO_PASSWORD=your-dataforseo-password
# Deprecated rollback-only secret. New code does not call SerpAPI.
SERP_API_KEY=
# Mediastack API key — ingest-signals
MEDIASTACK_API_KEY=your-mediastack-api-key
# Podchaser API key — ingest-signals
PODCHASER_API_KEY=your-podchaser-api-key
# Podchaser OAuth credentials — ingest-signals and Content Radar
PODCHASER_CLIENT_ID=your-podchaser-client-id
PODCHASER_CLIENT_SECRET=your-podchaser-client-secret
# YouTube Data API key — Content Radar
YOUTUBE_API_KEY=your-youtube-api-key
# Optional Census API key — ingest-signals (the endpoint also permits keyless requests)
CENSUS_API_KEY=your-census-api-key
# Guardian Open Platform API key — ingest-signals, scripts/historical-backfill.ts
GUARDIAN_API_KEY=your-guardian-api-key
# Retired 2026-05-30; retained only for rollback support.
NYT_API_KEY=your-nyt-api-key
# Optional: comma-separated source IDs to skip (e.g. "gofractional,serpapi_trends")
SKIP_SOURCES=
# Optional: comma-separated Content Radar collectors to skip
SKIP_CONTENT_SOURCES=
