{
  "crons": [
    {
      "path": "/api/cron/daily-ingest",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/weekly-ingest",
      "schedule": "0 6 * * 1"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/feed.xml", "destination": "https://dtlcprcpvdomrehbejhw.supabase.co/functions/v1/fwi-feed" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
